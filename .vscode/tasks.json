{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PyInstaller Build",
            "type": "shell",
            "command": "pyinstaller.exe",
            "args": [
                "OpenRadar.spec"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "type": "austin",
            "file": "OpenRadar.py",
            "label": "Profile OpenRadar.py",
        },
        {
            "label": "Run ACMI Test Stream",
            "type": "shell",
            "command": "python",
            "args": [
                "scripts/AcmiFiletoStream.py",
                "Data/2025-12-13_20-05-14.zip.acmi",
                "--timemultiplier",
                "32"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}